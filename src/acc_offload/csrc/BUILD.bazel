load("//bazel:global_options.bzl", "GLOBAL_COPTS", "GLOBAL_LOCAL_DEFINES", "GLOBAL_LINKOPTS")

package(default_visibility = ["//visibility:private"])

COMMON_LINKOPTS = GLOBAL_LINKOPTS + []

config_setting(
    name = "mf_debug_build",
    values = {"compilation_mode": "dbg"},
)

COMMON_LOCAL_DEFINES = GLOBAL_LOCAL_DEFINES + select({
    ":mf_debug_build": ["MF_ENABLE_TRACEPOINT"],
    "//conditions:default": [],
})

COMMON_COPTS = GLOBAL_COPTS + ["-fPIC"]

cc_library(
    name = "acc_offload_src_headers",
    hdrs = glob([
        "*.h",
        "common/*.h",
        "allocator/*.h",
        "launch/*.h",
        "operators/*.h",
    ]),
    includes = [".", "common", "allocator", "launch", "operators"],
    visibility = ["//visibility:public"],
)

# acc_offload: glob all, then EXCLUDE operators/ and kernel_launch (AscendC kernel,
# compiled at install time via try_install_extend, see script/run_pkg_maker/install.sh)
# and python_wrapper/ (built as separate pybind_extension target)
ACC_OFFLOAD_SRCS = glob(
    ["*.cpp", "common/*.cpp", "allocator/*.cpp", "launch/*.cpp"],
    exclude = [
        "launch/acc_offload_operators_launch.cpp",
    ],
)

cc_library(
    name = "acc_offload_objects",
    srcs = ACC_OFFLOAD_SRCS,
    linkstatic = True,
    local_defines = [] + COMMON_LOCAL_DEFINES,
    copts = [] + COMMON_COPTS,
    linkopts = [] + COMMON_LINKOPTS,
    deps = [
        "@version_info//:version_info",
        "//src/smem/csrc:smem_src_headers",
        "//src/smem/csrc/config_store:config_store_headers",
        ":acc_offload_src_headers",
        "//src:acc_offload_headers",
        "//src:util_headers",
        "//src:acc_links_headers",
        "//src:hybm_headers",
        "//src/hybm/csrc:hybmm_shared",
        "//src:smem_headers",
    ],
    alwayslink = True,
)

cc_library(
    name = "acc_offload_shared",
    visibility = [
        "//src/acc_offload/csrc/python_wrapper:__pkg__",
    ],
    srcs = [],
    linkstatic = False,
    local_defines = [] + COMMON_LOCAL_DEFINES,
    copts = [] + COMMON_COPTS,
    linkopts = [
        "-Wl,-z,noexecstack,-z,relro,-z,now",
        "-s",
        "-lpthread",
        "-Wl,--start-group",
        "-lrt",
        "-Wl,--end-group",
        "-ldl",
    ] + COMMON_LINKOPTS,
    deps = [
        "@version_info//:version_info",
        ":acc_offload_objects",
        "//src/hybm/csrc:hybmm_shared",
        "//src/smem/csrc:smem_shared",
    ],
    alwayslink = True,
)

cc_library(
    name = "acc_offload_static",
    srcs = [],
    linkstatic = True,
    local_defines = [] + COMMON_LOCAL_DEFINES,
    copts = [] + COMMON_COPTS,
    linkopts = [] + COMMON_LINKOPTS,
    deps = [
        "@version_info//:version_info",
        ":acc_offload_objects",
        "//src/smem/csrc:smem_static",
        "//src/hybm/csrc:hybmm_static",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libmf_acc_offload.so",
    srcs = [],
    deps = [
        "@version_info//:version_info",
        ":acc_offload_shared",
    ],
    # Keep runtime lookup behavior aligned with CMake's BUILD_RPATH/INSTALL_RPATH=$ORIGIN.
    # This lets dlopen()ed dependencies resolve sibling shared libraries after install,
    # such as libraries bundled into the same Python wheel lib directory.
    linkopts = [
        "-Wl,-rpath,$ORIGIN",
    ],
    linkshared = 1,
    visibility = ["//visibility:public"],
)
